---
/**
 * LOCALIZAÇÃO — ILUSTRAR
 *
 * Responsabilidades:
 * - Apresentar o endereço da escola;
 * - Exibir informações para visitantes;
 * - Disponibilizar a rota pelo Google Maps;
 * - Facilitar o contato pelo WhatsApp.
 *
 * Os dados são centralizados em site.ts.
 */

import { Image } from "astro:assets";
import mapaIlustrar from "../../../assets/images/localizacao/mapa-ilustrar.webp";
import SectionHeading from "../../ui/SectionHeading.astro";

import {
gerarLinkRota,
gerarLinkWhatsApp,
site,
} from "../../../data/site";

import "./Location.css";

// Links externos
const rotaUrl = gerarLinkRota();

const contatoUrl = gerarLinkWhatsApp(
  site.whatsapp.numero,
  "Olá! Gostaria de agendar uma visita à ILUSTRAR."
);
---

<section
  id="localizacao"
  class="section location"
  aria-labelledby="localizacao-title"
>
  <div class="location__inner">

    <!-- Informações da escola -->
    <div class="location__content">

      <SectionHeading
        id="localizacao-title"
        eyebrow="Onde estamos"
        title="Venha conhecer a Ilustrar de perto."
        align="left"
      />

      <!-- Endereço oficial -->
      <address class="location__address">
        <strong>{site.endereco.rua}</strong>

        <span>{site.endereco.cidade}</span>

        <small>
          Referência: {site.endereco.referencia}
        </small>
      </address>

      <!-- Orientações para visitantes -->
      <div class="location__notes">

        <div>
          <strong>Atendimento</strong>
          <p>
            Terça a sexta: das 9:00 às 17:30.
            Sábado: 8:00 às 17:30
          </p>
        </div>

        <div>
          <strong>Primeira visita</strong>
          <p>
            Agende para a equipe preparar
            a melhor experiência.
          </p>
        </div>

      </div>

      <!-- Ações disponíveis -->
      <div class="location__actions">

        <a
          class="location__button"
          href={rotaUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Abrir rota no Google Maps
          <span aria-hidden="true">↗</span>
        </a>

        <a
          class="location__contact"
          href={contatoUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Falar com a escola
          <span aria-hidden="true">↗</span>
        </a>

      </div>

    </div>


    <Image
      class="location__map"
      src={mapaIlustrar}
      alt="Mapa ilustrativo da localização da ILUSTRAR em Ibiúna."
      width={900}
      height={600}
      loading="lazy"
      decoding="async"
    />


  </div>
</section>
